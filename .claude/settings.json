{
  "permissions": {
    "allow": [
      "Bash(rm -rf -- /home/vscode/.claude/projects/-tmp-*)",
      "Bash(rm -rf -- /home/vscode/.claude/projects/-workspaces-holon*)",
      "Bash(rm -rf /tmp/claude-1000/*)",

      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(node framework/bin/holarch-spawn.js *)",
      "Bash(node tools/*)",

      "Bash(git push holarch-dev *)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune*)",
      "Bash(git branch -D *)",
      "Bash(git tag *)"
    ]
  }
}
,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/holarch-session/etat.js\" --hook",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/holarch-session/passation.js\" --hook-precompact",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/holarch-session/garde.js\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/holarch-session/garde.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/holarch-session/garde.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/holarch-session/garde.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/holarch-session/etat.js\" --hook-prompt",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
